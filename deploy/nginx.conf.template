worker_processes 1;
error_log stderr warn;
pid /tmp/replayforge-nginx.pid;
events { worker_connections 256; }
http {
    server_names_hash_bucket_size 128;
    access_log off;
    client_max_body_size 32k;
    server {
        listen 8080 default_server;
        server_name _;
        return 421;
    }
    server {
        listen 8080;
        server_name __PUBLIC_HOST__;
        if ($http_host != "__PUBLIC_HOST__") { return 403; }
        if ($http_x_forwarded_proto != "https") { return 403; }
        location = /health/live {
            proxy_pass http://127.0.0.1:8000;
            include /app/deploy/proxy-api.conf;
        }
        location = /health/ready {
            proxy_pass http://127.0.0.1:8000;
            include /app/deploy/proxy-api.conf;
        }
        location = /api/v1/auth/github/start {
            proxy_pass http://127.0.0.1:8000;
            include /app/deploy/proxy-api.conf;
        }
        location = /api/v1/auth/github/callback {
            proxy_pass http://127.0.0.1:8000;
            include /app/deploy/proxy-api.conf;
        }
        location / {
            proxy_pass http://127.0.0.1:3000;
            proxy_set_header Host __PUBLIC_HOST__;
            proxy_set_header X-Forwarded-Proto https;
            proxy_set_header X-Forwarded-For "";
            proxy_set_header X-Forwarded-Host "";
            proxy_buffering off;
        }
    }
    server {
        listen 127.0.0.1:8081;
        server_name localhost;
        location / {
            proxy_pass http://127.0.0.1:8000;
            proxy_set_header Host __PUBLIC_HOST__;
            proxy_set_header X-Forwarded-Proto https;
            proxy_set_header X-Forwarded-For "";
            proxy_set_header X-Forwarded-Host "";
        }
    }
}
