FROM node:22.19.0-bookworm-slim@sha256:4a4884e8a44826194dff92ba316264f392056cbe243dcc9fd3551e71cea02b90
WORKDIR /app/apps/web
RUN chown node:node /app/apps/web
COPY --chown=node:node apps/web/package.json apps/web/package-lock.json ./
USER node
RUN npm ci
COPY --chown=node:node apps/web/ ./
RUN npm run build
ENV NODE_ENV=production NEXT_TELEMETRY_DISABLED=1
CMD ["node", "scripts/start-public.mjs"]
