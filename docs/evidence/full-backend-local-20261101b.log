                )
                expired_bytes = canonical(expired)
                expired_ref = "sha256:" + hashlib.sha256(expired_bytes).hexdigest()
                conn.execute(
                    "UPDATE replay_submissions SET capability_payload=%s,capability_ref=%s "
                    "WHERE run_id=%s AND phase='CANDIDATE'",
