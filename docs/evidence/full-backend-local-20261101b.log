                    "WHERE run_id=%s AND phase='EXISTING_SUITE'",
                    (run.run_id,),
                )
            elif adversarial_case == "tampered_evidence_bundle":
                conn.execute(
                    "UPDATE evidence_bundles SET payload=payload || decode('20','hex') "
                    "WHERE run_id=%s",
                    (run.run_id,),
                )
            elif adversarial_case == "wrong_runtime_binding":
