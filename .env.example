# Set in the process environment; this file is not automatically loaded.
NEBIUS_API_KEY=
NEBIUS_BASE_URL=https://api.tokenfactory.us-central1.nebius.com/v1/
NEBIUS_MODEL_PRIMARY=nvidia/nemotron-3-super-120b-a12b

# Remote sandbox smoke: activated project and existing approved image required.
# Neither image imports nor guest operations run without explicit --live.
NEBIUS_PROJECT_ID=
SANDBOX_IMAGE_UUID=
SANDBOX_REMOTE_URL=https://api.tokenfactory.nebius.com/sandboxes/

# Optional public documentation search; explicit --live also required.
ENABLE_TAVILY=false
TAVILY_API_KEY=

# Local PostgreSQL/operator setup only. Separate runtime and migrator roles.
# No .env auto-loading; never use the postgres administrator in the API.
DATABASE_URL=
REPLAYFORGE_MIGRATION_DATABASE_URL=

# Optional explicit loopback GitHub-session mode. Blank values are intentional.
# Separate auth and execution DB roles are mandatory; see docs/github-authentication.md.
REPLAYFORGE_DATABASE_URL=
# Optional operator-only image journal connection. Use a dedicated least-
# privilege writer identity; never reuse the API, collection, or migration URL.
REPLAYFORGE_IMAGE_IMPORT_DATABASE_URL=
# Local-only API/BFF identity. Configure values in the process environment;
# the operator provisions matching repository grants separately.
REPLAYFORGE_API_TOKEN=
REPLAYFORGE_OWNER_ID=
REPLAYFORGE_APPROVED_REPOSITORIES=[]
REPLAYFORGE_AUTH_DATABASE_URL=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
REPLAYFORGE_AUTH_ENCRYPTION_KEY_HEX=
REPLAYFORGE_AUTH_HMAC_KEY_HEX=
REPLAYFORGE_AUTH_ENABLE_GITHUB=false
REPLAYFORGE_AUTH_API_ORIGIN=http://127.0.0.1:8000
REPLAYFORGE_AUTH_WEB_ORIGIN=http://127.0.0.1:3000
REPLAYFORGE_WEB_AUTH_MODE=local
REPLAYFORGE_API_URL=http://127.0.0.1:8000

# Public App slug for the server-rendered Manage GitHub access link.
GITHUB_APP_SLUG=

# Internal collection service (off by default). Never put vault/GitHub keys in worker env.
REPLAYFORGE_ENABLE_COLLECTION_BROKER=false
REPLAYFORGE_COLLECTION_WORKER_KEY=
REPLAYFORGE_COLLECTION_BROKER_URL=http://127.0.0.1:8000
REPLAYFORGE_WORKER_PATHS=["README.md"]

# Session human review. Set an explicit allowed PR target branch to install review routes.
REPLAYFORGE_APPROVAL_TARGET_BRANCH=
# Isolated App signing key reference (local absolute .pem path; never a NEXT_PUBLIC key).
GITHUB_APP_PRIVATE_KEY_PATH=
# Publication route remains off until deliberate operator activation.
REPLAYFORGE_ENABLE_GITHUB_PUBLICATION=false

# Production verification worker trust. Keep this worker in a separate process
# with a least-privilege database identity. The JSON file contains public trust
# anchors and phase bindings only; signing stays in an operator-owned KMS/HSM
# adapter module. Do not put private keys or provider credentials here.
REPLAYFORGE_VERIFICATION_TRUST_PROVIDER=services.orchestrator.deployment_trust
REPLAYFORGE_VERIFICATION_TRUST_CONFIG=
REPLAYFORGE_VERIFICATION_SIGNER_PROVIDER=
REPLAYFORGE_VERIFICATION_WORKER_ID=
REPLAYFORGE_VERIFICATION_WORKER_ROLE=
REPLAYFORGE_DATABASE_NAME=
REPLAYFORGE_SCHEMA_REVISION=0036
